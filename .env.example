# Local:
# DATABASE_URL=postgresql+asyncpg://groupor:groupor@localhost:5432/groupor
#
# Railway: add a PostgreSQL plugin, then set DATABASE_URL to the plugin variable
# (Variables → Variable Reference → Postgres → DATABASE_URL). Do not leave localhost.
DATABASE_URL=postgresql+asyncpg://groupor:groupor@localhost:5432/groupor
SITE_URL=https://YOUR-RAILWAY-SERVICE.up.railway.app
SITE_NAME=Groupor
SESSION_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=https://YOUR-VERCEL-APP.vercel.app,http://localhost:8080,http://localhost:8081
